
{
  "manifest_version": 3,
  "name": "SummarAI",
  "version": "1.0.0",
  "description": "AI-powered summarizer for web pages, PDFs, text and links",

  "action": {
    "default_popup": "index.html",
    "default_title": "SummarAI"
  },

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}